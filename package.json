{
  "name": "rice-tracker",
  "version": "0.1.0",
  "description": "Firebase-powered issue tracker CLI with dependency graphs, real-time sync, and Jira integration",
  "type": "module",
  "bin": {
    "rt": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "issue-tracker",
    "firebase",
    "firestore",
    "cli",
    "jira",
    "dependency-graph",
    "project-management",
    "real-time",
    "ai-agent"
  ],
  "author": "Vikash Ruhil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vikashruhilgit/rice-tracker.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@octokit/rest": "^22.0.1",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "conf": "^13.1.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.3.1",
    "firebase": "^11.4.0",
    "jira.js": "^5.3.0",
    "nanoid": "^5.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^3.0.5"
  }
}
